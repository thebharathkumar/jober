# Copy to .env and fill in. Everything here is OPTIONAL — the core runs without it.

# Enables the real LLM answerer and the semantic LLM judge. Without it, the
# pipeline uses the offline extractive provider and lexical judge.
ANTHROPIC_API_KEY=

# Raises the GitHub API rate limit for `bus-factor ingest`. Unauthenticated
# requests work but are throttled.
GITHUB_TOKEN=

# --- tunables (defaults shown) ---
# BF_LOG_LEVEL=INFO          # DEBUG for verbose logs (or use --verbose)
# BF_MODEL=claude-sonnet-5
# BF_MAX_TOKENS=700
# BF_TOP_K=5                 # retrieved documents per question
# BF_RRF_K=60               # reciprocal-rank-fusion constant
# BF_STALENESS_WARN_DAYS=365 # flag answers whose freshest evidence is older
# BF_LOW_CONFIDENCE=0.35    # below this, recommend routing to a human
# BF_ABSTAIN_THRESHOLD=0.35 # below this CALIBRATED confidence, the answerer abstains
# BF_HOLDOUT_FRACTION=0.3   # eval holdout size
# BF_JUDGE_F1=0.4           # lexical judge correctness threshold
